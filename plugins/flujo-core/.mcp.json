{
  "mcpServers": {
    "sequentialthinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["@upstash/context7-mcp@latest"]
    },
    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": ["mcp-fetch-server"]
    },
    "codebase-memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["codebase-memory-mcp"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "postgres-real-data": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${user_config.db_connection}"]
    }
  }
}
